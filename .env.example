# Copy this file to .env.local. Safe React variables only (VITE_ values are public).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_ORGANISATION_ID=YOUR_ORGANISATION_UUID
# Set these as Supabase Edge Function secrets, not here and never with a VITE_ prefix:
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
